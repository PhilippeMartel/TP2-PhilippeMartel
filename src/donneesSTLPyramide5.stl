solid pyramide
  facet normal 1 0 0
    outer loop
      vertex 0 0 8.0
      vertex 3.5 3.5 0
      vertex 3.5 -3.5 0
    endloop
  endfacet

  facet normal -1 0 0
    outer loop
      vertex 0 0 8.0
      vertex -3.5 3.5 0
      vertex -3.5 -3.5 0
    endloop
  endfacet

  facet normal 0 1 0
    outer loop
      vertex 0 0 8.0
      vertex 3.5 3.5 0
      vertex -3.5 3.5 0
    endloop
  endfacet

  facet normal 0 -1 0
    outer loop
      vertex 0 0 8.0
      vertex 3.5 -3.5 0
      vertex -3.5 -3.5 0
    endloop
  endfacet

  facet normal 0 0 -1
    outer loop
      vertex 3.5 -3.5 0
      vertex 0 3.5 3.5 0
      vertex -3.5 -3.5 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex -3.5 3.5 0
      vertex 0 3.5 3.5 0
      vertex -3.5 -3.5 0
    endloop
  endfacet
