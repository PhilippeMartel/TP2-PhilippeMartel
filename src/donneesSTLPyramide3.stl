solid pyramide
  facet normal 1 0 0
    outer loop
      vertex 0 0 10.0
      vertex 2.5 2.5 0
      vertex 2.5 -2.5 0
    endloop
  endfacet

  facet normal -1 0 0
    outer loop
      vertex 0 0 10.0
      vertex -2.5 2.5 0
      vertex -2.5 -2.5 0
    endloop
  endfacet

  facet normal 0 1 0
    outer loop
      vertex 0 0 10.0
      vertex 2.5 2.5 0
      vertex -2.5 2.5 0
    endloop
  endfacet

  facet normal 0 -1 0
    outer loop
      vertex 0 0 10.0
      vertex 2.5 -2.5 0
      vertex -2.5 -2.5 0
    endloop
  endfacet

  facet normal 0 0 -1
    outer loop
      vertex 2.5 -2.5 0
      vertex 0 2.5 2.5 0
      vertex -2.5 -2.5 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex -2.5 2.5 0
      vertex 0 2.5 2.5 0
      vertex -2.5 -2.5 0
    endloop
  endfacet
