solid pyramide
  facet normal 1 0 0
    outer loop
      vertex 0 0 22.0
      vertex 2.0 2.0 0
      vertex 2.0 -2.0 0
    endloop
  endfacet

  facet normal -1 0 0
    outer loop
      vertex 0 0 22.0
      vertex -2.0 2.0 0
      vertex -2.0 -2.0 0
    endloop
  endfacet

  facet normal 0 1 0
    outer loop
      vertex 0 0 22.0
      vertex 2.0 2.0 0
      vertex -2.0 2.0 0
    endloop
  endfacet

  facet normal 0 -1 0
    outer loop
      vertex 0 0 22.0
      vertex 2.0 -2.0 0
      vertex -2.0 -2.0 0
    endloop
  endfacet

  facet normal 0 0 -1
    outer loop
      vertex 2.0 -2.0 0
      vertex 0 2.0 2.0 0
      vertex -2.0 -2.0 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex -2.0 2.0 0
      vertex 0 2.0 2.0 0
      vertex -2.0 -2.0 0
    endloop
  endfacet
